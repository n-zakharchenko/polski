rules_version = '2';

// Правила доступа к базе Firestore проекта polski-3f3c1.
// Вставляются вручную: Firebase Console → Firestore Database → Rules → Publish.
//
// users/{uid} = { points, tests, perfect, updatedAt } — пишет только сам пользователь, один раз за тест.
// Сервера нет, очки считает браузер, поэтому правила хотя бы ограничивают накрутку:
//   очки только растут, не больше MAX_GAIN за запись; tests +1 за запись; не чаще раза в 30 с.
// MAX_GAIN (5000) должен быть не меньше Polski.balance.maxForTest(rounds) — сейчас 4250 при 15 заданиях.
// Всё остальное в базе закрыто.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function shape(d) {
        return d.keys().hasOnly(['points', 'tests', 'perfect', 'updatedAt'])
          && d.points is int && d.tests is int && d.perfect is int
          && d.updatedAt == request.time;
      }

      allow read, delete: if owner();

      allow create: if owner() && shape(request.resource.data)
        && request.resource.data.points >= 0
        && request.resource.data.points <= 5000
        && request.resource.data.tests == 1
        && request.resource.data.perfect in [0, 1];

      allow update: if owner() && shape(request.resource.data)
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points - resource.data.points <= 5000
        && request.resource.data.tests == resource.data.tests + 1
        && request.resource.data.perfect - resource.data.perfect in [0, 1]
        && request.time > resource.data.updatedAt + duration.value(30, 's');
    }
  }
}
