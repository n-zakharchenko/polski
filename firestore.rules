rules_version = '2';

// Правила доступа к базе Firestore проекта polski-3f3c1.
// Вставляются вручную: Firebase Console → Firestore Database → Rules → Publish.
//
// Данные пользователя лежат в users/{uid} и во вложенных коллекциях.
// Читать и писать их может только сам пользователь; всё остальное закрыто.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
